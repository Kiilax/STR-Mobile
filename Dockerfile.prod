FROM node:20

RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    curl \
    git \
    unzip \
    python3 \
    build-essential \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

RUN npm install -g eas-cli expo-cli

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG EXPO_TOKEN
ENV EXPO_TOKEN=$EXPO_TOKEN

ARG EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
ENV EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY

CMD ["sh", "-c", "\
  echo 'DEBUG:' && pwd && ls -a && echo 'END DEBUG'"; \
  echo \"Using EXPO_TOKEN=${EXPO_TOKEN:+***redacted***}\"; \
  JSON=$(eas build --platform android --profile apk --non-interactive --json) || { echo \"eas build failed\"; echo \"$JSON\"; exit 1; } ; \
  BUILD_ID=$(echo \"$JSON\" | jq -r '.id // .buildId') ; \
  echo \"Build ID: $BUILD_ID\" ; \
  RESULT=$(eas build:view \"$BUILD_ID\" --json) ; \
  ARTIFACT_URL=$(echo \"$RESULT\" | jq -r '.artifacts[0].url // .artifactUrl') ; \
  if [ -z \"$ARTIFACT_URL\" ] ; then echo \"No artifact URL found:\"; echo \"$RESULT\"; exit 1; fi ; \
  echo \"Downloading APK from: $ARTIFACT_URL\" ; \
  curl -L -o /app/app.apk \"$ARTIFACT_URL\" ; \
  ls -lh /app/app.apk ; \
"]

